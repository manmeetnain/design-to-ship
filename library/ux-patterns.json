{
  "version": "0.3.0",
  "patterns": [
    {"id":"authentication","job":"Establish identity with proportionate friction.","must_cover":["Sign in","Account creation","Recovery","Expired session","Alternative method"],"avoid":["Password rules shown only after failure","Account enumeration","Blocked recovery"],"verify":["Keyboard completion","Error association","Recovery path"]},
    {"id":"onboarding","job":"Reach first meaningful value while collecting only necessary setup.","must_cover":["Expectation","Progress","Skip or defer","Resume","First success"],"avoid":["Feature tours before context","Mandatory personalization without value","No return path"],"verify":["Time to first value","Resume after interruption"]},
    {"id":"navigation","job":"Help people locate themselves and move predictably.","must_cover":["Current location","Primary destinations","Back behavior","Deep link","Permission differences"],"avoid":["Competing navigation systems","Icon-only ambiguity","State lost on return"],"verify":["Keyboard order","Small-screen reachability","Deep-link landing"]},
    {"id":"search-filter","job":"Reduce a large result space without hiding active constraints.","must_cover":["Query","Suggestions","Active filters","No results","Clear or revise"],"avoid":["Invisible filters","Reset on navigation","Unexplained ranking"],"verify":["Result announcement","Zero state","Long query and many filters"]},
    {"id":"forms","job":"Collect accurate information with clear effort and recovery.","must_cover":["Labels","Instructions","Validation","Saved progress","Submission state"],"avoid":["Placeholder-only labels","Premature errors","Data loss"],"verify":["Keyboard completion","Error summary","Autofill and long content"]},
    {"id":"checkout","job":"Make commitment, cost, delivery, and recovery understandable.","must_cover":["Cart review","Identity choice","Delivery","Payment","Final review","Receipt"],"avoid":["Late fees","Forced registration","Ambiguous final action"],"verify":["Guest path","Rejected payment","Price change"]},
    {"id":"data-table","job":"Compare, locate, and act on structured records.","must_cover":["Column meaning","Sort","Filter","Selection","Bulk action","Empty and loading"],"avoid":["Horizontal overflow without strategy","Icon-only actions","Selection lost silently"],"verify":["Keyboard access","Narrow viewport alternative","Large dataset state"]},
    {"id":"dashboard","job":"Support a defined monitoring or decision task.","must_cover":["Priority","Freshness","Comparison","Drill-down","Data limitations"],"avoid":["Decorative metrics","Equal card weight","Charts without decisions"],"verify":["Question-to-widget trace","Stale data","No-data state"]},
    {"id":"notifications","job":"Deliver timely information without stealing control.","must_cover":["Urgency","Source","Action","Read state","Preferences"],"avoid":["Everything marked urgent","Dead-end alerts","Unclear dismissal"],"verify":["Screen-reader announcement","Batching","Preference effect"]},
    {"id":"permissions","job":"Explain why access is needed and what changes after consent.","must_cover":["Just-in-time rationale","System prompt","Denial","Limited mode","Settings recovery"],"avoid":["Cold permission prompts","Repeated pressure","False necessity"],"verify":["Denied path","Revoked path","Plain-language purpose"]},
    {"id":"file-upload","job":"Transfer files with constraints, progress, correction, and recovery.","must_cover":["Selection","Requirements","Progress","Cancel","Failure","Replace or remove"],"avoid":["Silent size limits","Fake progress","No retry"],"verify":["Keyboard selection","Unsupported file","Network interruption"]},
    {"id":"billing","job":"Make plan value, limits, changes, and cancellation explicit.","must_cover":["Current plan","Usage","Upgrade","Downgrade","Payment failure","Cancellation"],"avoid":["Hidden renewal","Obstructed cancellation","Irreversible downgrade surprise"],"verify":["Proration explanation","Failed payment","Data retention after cancellation"]},
    {"id":"settings","job":"Expose durable preferences with clear scope and effect.","must_cover":["Grouping","Current value","Save behavior","Reset","Account-level danger zone"],"avoid":["Mixed scopes","Unannounced autosave","Destructive actions beside routine controls"],"verify":["Persistence","Reset confirmation","Search or findability"]},
    {"id":"collaboration","job":"Coordinate shared work with visible ownership and change history.","must_cover":["Presence","Ownership","Conflict","Comments","Mentions","Activity"],"avoid":["Invisible overwrites","Ambiguous permissions","Notification floods"],"verify":["Concurrent change","Permission mismatch","Mention delivery"]},
    {"id":"ai-generation","job":"Help a person direct, inspect, correct, and trust generated work.","must_cover":["Input scope","Progress","Cancel","Sources","Edit","Retry","History"],"avoid":["Fabricated certainty","Hidden actions","No recovery","Unbounded generation"],"verify":["Interrupted run","Unsupported request","Source inspection"]},
    {"id":"empty-state","job":"Explain why content is absent and the most useful next action.","must_cover":["Cause","Context","Primary next action","Permission or filter state"],"avoid":["Celebratory copy during failure","Generic illustration without guidance"],"verify":["First use","Filtered empty","Permission empty"]},
    {"id":"error-recovery","job":"Preserve work and help the user recover from a specific failure.","must_cover":["What happened","What was preserved","Next action","Escalation","Reference ID when useful"],"avoid":["Something went wrong","Blame","Retry loops"],"verify":["Offline","Timeout","Validation","Server failure"]},
    {"id":"destructive-action","job":"Prevent accidental irreversible or high-impact change.","must_cover":["Specific consequence","Scope","Confirmation proportional to risk","Undo when possible"],"avoid":["Generic Are you sure","Danger action as default","Color-only warning"],"verify":["Keyboard focus","Cancel","Undo or recovery"]},
    {"id":"progress-status","job":"Set expectations during work whose duration or outcome is uncertain.","must_cover":["Current state","Useful progress","Cancel","Background behavior","Completion or failure"],"avoid":["Fake precision","Frozen spinners","No interruption"],"verify":["Long duration","Cancellation","Background return"]},
    {"id":"first-use-guidance","job":"Reveal the next useful action in context.","must_cover":["Goal","One next step","Example or safe default","Dismiss or revisit"],"avoid":["Multi-screen tours","Blocking explanation","Teaching every feature"],"verify":["Skipped guidance","Return visit","No sample data"]}
  ]
}

